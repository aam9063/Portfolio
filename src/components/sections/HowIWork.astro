---
import Container from "@components/Container.astro"

type Step = {
  icon: string
  title: string
  body: string
}

type Props = {
  steps: Step[]
}

const { steps } = Astro.props
---

<section id="how-i-work" class="animate py-24">
  <Container size="content">
    <p class="font-mono text-sm uppercase tracking-wide text-faint">
      How I work
    </p>
    <h2 class="mt-2 text-2xl md:text-3xl font-semibold text-text">
      An agent-first process, applied to real problems
    </h2>
    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
      {steps.map((step, index) => (
        <li class="flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <span class="font-mono text-sm text-faint">
              {String(index + 1).padStart(2, "0")}
            </span>
            <svg class="size-5 stroke-current text-faint">
              <use href={`/ui.svg#${step.icon}`}/>
            </svg>
          </div>
          <div class="font-semibold text-text">
            {step.title}
          </div>
          <p class="text-sm text-muted">
            {step.body}
          </p>
        </li>
      ))}
    </ol>
  </Container>
</section>
