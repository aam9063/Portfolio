---
import Container from "@components/Container.astro"
---

<section id="hero" class="pt-32 pb-24">
  <Container size="content">
    <div class="animate max-w-3xl">
      <p class="font-mono text-sm uppercase tracking-wide text-faint">
        Product Engineer &middot; Forward Deployed &middot; AI Builder
      </p>
      <h1 class="mt-4 text-3xl md:text-5xl font-extrabold leading-tight text-text">
        I build software with AI for problems nobody had digitized yet.
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted">
        Junior full-stack engineer at Softtek, working toward Forward Deployed Engineer and AI Builder roles. I sit with real clients, turn messy workflows into working software, and build fast with an agent-first process: Claude Code, MCP, Spec-Driven Development.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="#case-studies" class="py-2.5 px-5 rounded truncate text-sm md:text-base bg-accent text-black hover:bg-accent-strong blend">
          View case studies
        </a>
        <a href="/blog" class="py-2.5 px-5 truncate rounded text-sm md:text-base border border-border hover:bg-panel blend">
          Read the blog
        </a>
      </div>
    </div>
  </Container>
</section>
