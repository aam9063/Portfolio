---
import type { CollectionEntry } from "astro:content"
import { truncateText } from "@lib/utils"

type Props = {
  entry: CollectionEntry<"projects">
}

const { entry } = Astro.props
const { title, summary, tags, status, image, iconImage } = entry.data
const isComingSoon = status === "coming-soon"

const iconMap: Record<string, string> = {
  factuscan: "scan",
  "industrial-yaml-tool": "terminal",
  "training-track": "graduation-cap",
}
const icon = iconMap[entry.slug] ?? "scan"

const cardClasses = "group h-full flex flex-col gap-4 p-5 rounded-lg bg-card border border-border transition-colors duration-300 ease-in-out"
---

{isComingSoon ? (
  <div class={`${cardClasses} opacity-70 cursor-default`}>
    {image ? (
      <img src={image} alt={title} class="w-full aspect-video object-cover rounded-md grayscale" />
    ) : iconImage ? (
      <img src={iconImage} alt={title} class="size-8 rounded grayscale" />
    ) : (
      <svg class="size-8 stroke-current">
        <use href={`/ui.svg#${icon}`}/>
      </svg>
    )}
    <div class="flex-1">
      <div class="font-semibold text-text">
        {title}
      </div>
      <div class="text-sm line-clamp-2 mt-1">
        {summary}
      </div>
    </div>
    <div class="flex items-center justify-between">
      <ul class="flex flex-wrap gap-1">
        {tags.slice(0, 3).map((tag: string) => (
          <li class="font-mono text-xs uppercase py-0.5 px-2 rounded bg-panel text-muted">
            {truncateText(tag, 20)}
          </li>
        ))}
      </ul>
      <span class="font-mono text-xs uppercase py-0.5 px-2 rounded-full border border-border">
        Coming soon
      </span>
    </div>
  </div>
) : (
  <a href={`/projects/${entry.slug}`} class={`${cardClasses} hover:bg-panel`}>
    {image ? (
      <img src={image} alt={title} class="w-full aspect-video object-cover rounded-md" />
    ) : iconImage ? (
      <img src={iconImage} alt={title} class="size-8 rounded" />
    ) : (
      <svg class="size-8 stroke-current">
        <use href={`/ui.svg#${icon}`}/>
      </svg>
    )}
    <div class="flex-1">
      <div class="font-semibold text-text">
        {title}
      </div>
      <div class="text-sm line-clamp-2 mt-1">
        {summary}
      </div>
    </div>
    <div class="flex items-center justify-between">
      <ul class="flex flex-wrap gap-1">
        {tags.slice(0, 3).map((tag: string) => (
          <li class="font-mono text-xs uppercase py-0.5 px-2 rounded bg-panel text-muted">
            {truncateText(tag, 20)}
          </li>
        ))}
      </ul>
      <span class="w-fit flex gap-1 items-center text-sm font-medium text-muted group-hover:text-text blend">
        Read case study
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current">
          <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
          <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        </svg>
      </span>
    </div>
  </a>
)}
