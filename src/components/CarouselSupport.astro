---
// Shared support for Swiper carousels authored inside markdown content
// (`.shift-carousel` markup). Include once per page layout.
---

<style is:global>
  .shift-carousel {
    --swiper-navigation-color: #9ca3af;
    --swiper-pagination-color: #9ca3af;
    border: 1px solid rgba(128, 128, 128, 0.35);
    border-radius: 0.5rem;
    padding: 1rem;
  }
  .shift-carousel .swiper-slide {
    height: min(520px, 62vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .shift-carousel .swiper-slide img {
    max-width: 100%;
    max-height: calc(100% - 2.5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.375rem;
    user-select: none;
    -webkit-user-drag: none;
  }
  .shift-carousel .slide-caption {
    margin-top: auto;
    text-align: center;
    font-size: 0.85rem;
    opacity: 0.75;
    padding-top: 0.6rem;
  }
  .shift-carousel .carousel-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 0.75rem;
  }
  .shift-carousel .carousel-footer .swiper-pagination {
    position: static;
    display: flex;
    justify-content: center;
    gap: 4px;
    width: auto;
  }
  .shift-carousel .carousel-footer .swiper-pagination-bullet {
    background: #9ca3af;
    opacity: 0.35;
  }
  .shift-carousel .carousel-footer .swiper-pagination-bullet-active {
    opacity: 1;
  }
  .shift-carousel .carousel-footer .swiper-button-prev,
  .shift-carousel .carousel-footer .swiper-button-next {
    position: static;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0;
    cursor: pointer;
  }
</style>

<script>
  import Swiper from "swiper"
  import { Navigation, Pagination } from "swiper/modules"
  import "swiper/css"
  import "swiper/css/navigation"
  import "swiper/css/pagination"

  document.querySelectorAll<HTMLElement>(".shift-carousel").forEach((el) => {
    new Swiper(el, {
      modules: [Navigation, Pagination],
      grabCursor: true,
      pagination: { el: el.querySelector<HTMLElement>(".swiper-pagination"), clickable: true },
      navigation: {
        nextEl: el.querySelector<HTMLElement>(".swiper-button-next"),
        prevEl: el.querySelector<HTMLElement>(".swiper-button-prev"),
      },
    })
  })
</script>
