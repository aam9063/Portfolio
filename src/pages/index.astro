---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Hero from "@components/sections/Hero.astro"
import ProofStrip from "@components/sections/ProofStrip.astro"
import CaseStudies from "@components/sections/CaseStudies.astro"
import HowIWork from "@components/sections/HowIWork.astro"
import BlogSection from "@components/sections/BlogSection.astro"
import AboutContact from "@components/sections/AboutContact.astro"
import { SITE, SOCIALS } from "@consts"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.date.getTime() - a.data.date.getTime()
  )
  .slice(0, 3)

const caseStudies = (await getCollection("projects"))
  .filter((project) => project.data.caseStudy)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const PROOF_POINTS = [
  {
    icon: "terminal",
    label: "Internal tool live in production for an industrial client, owned end to end",
    href: "/blog/11-yaml-config-tool-industrial-client",
  },
  {
    icon: "scan",
    label: "PWA used daily by a real courier business to replace paper logs",
  },
  {
    icon: "graduation-cap",
    label: "SaaS for coaches and athletes, in testing with real training groups",
  },
  {
    icon: "pen-tool",
    label: "Guest writer on Manfred's blog on breaking into tech in the AI era",
    href: "https://www.linkedin.com/pulse/ser-junior-en-la-era-de-ia-por-albert-alarc%C3%B3n-manfred-rxp8f/",
  },
]

const STEPS = [
  {
    icon: "message-square",
    title: "Talk to the client",
    body: "Sit with the real workflow before writing a line of code.",
  },
  {
    icon: "layers",
    title: "Spec it",
    body: "Turn the messy ask into a clear, scoped plan.",
  },
  {
    icon: "cpu",
    title: "Build with agents",
    body: "Claude Code, MCP, and an agent-first workflow to move fast.",
  },
  {
    icon: "check-circle",
    title: "Ship and iterate",
    body: "Get it in front of real users, then refine from real feedback.",
  },
]
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <Hero />
  <ProofStrip items={PROOF_POINTS} />
  <CaseStudies entries={caseStudies} />
  <HowIWork steps={STEPS} />
  <BlogSection posts={posts} />
  <AboutContact socials={SOCIALS} />
</PageLayout>
