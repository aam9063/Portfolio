---
import type { CollectionEntry } from "astro:content"
import Container from "@components/Container.astro"
import { formatDate, readingTime } from "@lib/utils"
import { CASE_STUDY_SECTIONS } from "@lib/caseStudy"

type Props = {
  entry: CollectionEntry<"projects">
}

const { entry } = Astro.props
const { title, summary, date, tags, demoUrl } = entry.data
const { Content, headings } = await entry.render()

const h2Headings = headings.filter((h) => h.depth === 2)

const normalize = (text: string) => text.trim().toLowerCase()

// Build the section index using the *actual* heading slugs Astro generated,
// so `href="#slug"` always matches the real DOM id in <Content/>.
const sectionIndex = CASE_STUDY_SECTIONS.map((canonicalText) => {
  const match = h2Headings.find((h) => normalize(h.text) === normalize(canonicalText))
  return match ? { text: canonicalText, slug: match.slug } : null
}).filter((section): section is { text: string; slug: string } => section !== null)

if (import.meta.env.DEV) {
  const foundTexts = new Set(h2Headings.map((h) => normalize(h.text)))
  const missing = CASE_STUDY_SECTIONS.filter((s) => !foundTexts.has(normalize(s)))
  if (missing.length > 0) {
    console.warn(
      `[CaseStudyLayout] "${title}" is missing canonical section(s): ${missing.join(", ")}`
    )
  }
}
---

<div class="animate pt-36">
  <Container size="content">
    <a href="/projects" class="group w-fit p-1.5 gap-1.5 text-sm flex items-center border rounded hover:bg-panel border-border transition-colors duration-300 ease-in-out">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-text">
        <line x1="19" y1="12" x2="5" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
        <polyline points="12 19 5 12 12 5" class="translate-x-1 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
      </svg>
      <div class="w-full group-hover:text-text transition-colors duration-300 ease-in-out">
        Back to projects
      </div>
    </a>

    <div class="flex flex-wrap text-sm uppercase mt-12 gap-3 text-muted font-mono">
      <div class="flex items-center gap-2">
        <svg class="size-5 stroke-current">
          <use href="/ui.svg#calendar"/>
        </svg>
        {formatDate(date)}
      </div>
      <div class="flex items-center gap-2">
        <svg class="size-5 stroke-current">
          <use href="/ui.svg#book-open"/>
        </svg>
        {readingTime(entry.body)}
      </div>
    </div>

    <h1 class="text-3xl md:text-4xl font-semibold text-text mt-2">
      {title}
    </h1>
    <p class="mt-2 text-muted">
      {summary}
    </p>

    <ul class="flex flex-wrap mt-4 gap-1">
      {tags.map((tag: string) => (
        <li class="font-mono text-xs uppercase py-0.5 px-2 rounded bg-panel text-muted">
          {tag}
        </li>
      ))}
    </ul>

    {demoUrl && (
      <a
        href={demoUrl}
        target="_blank"
        rel="noopener"
        class="group w-fit mt-4 flex items-center gap-1.5 px-4 py-2 rounded border border-border text-sm text-text hover:bg-panel blend"
      >
        Visit live site
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="translate-x-0 group-hover:translate-x-1 blend">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-10 mt-10">
      {sectionIndex.length > 0 && (
        <nav class="hidden lg:block sticky top-24 h-fit space-y-2 text-sm font-mono">
          {sectionIndex.map((section) => (
            <a
              href={`#${section.slug}`}
              class="block text-faint hover:text-text blend"
            >
              {section.text}
            </a>
          ))}
        </nav>
      )}
      <article class="lg:col-start-2">
        <Content/>
      </article>
    </div>
  </Container>
</div>
